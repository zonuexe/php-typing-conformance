{
    "name": "zonuexe/php-typing-conformance-runner",
    "description": "Conformance runner for PHP static analyzer compatibility tests.",
    "type": "project",
    "require": {
        "php-64bit": "^8.5",
        "internal/toml": "^1.1"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Conformance\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    }
}
