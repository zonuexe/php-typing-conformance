<?xml version="1.0"?>
<psalm
    phpVersion="8.5"
    errorLevel="1"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <!-- The corpus is analysed as one project, in a single run, rather than one
         invocation per test file. That is the only reason this handler has to
         exist: "this class is never extended" is a whole-project fact, so the
         issue could never fire while each file was looked at alone. It is an
         architecture rule and says nothing about type conformance, so it is
         suppressed rather than measured. -->
    <issueHandlers>
        <ClassMustBeFinal errorLevel="suppress" />
    </issueHandlers>
</psalm>
