<?xml version="1.0"?>
<psalm
    phpVersion="8.5"
    errorLevel="1"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- Psalm 7 emits MissingPureAnnotation / MissingAbstractPureAnnotation
             at every level; the corpus does not test mutation-free annotations,
             and Psalm 6 never reports them, so ignoring them keeps the two
             lines comparable. -->
        <MissingPureAnnotation errorLevel="suppress" />
        <MissingAbstractPureAnnotation errorLevel="suppress" />
    </issueHandlers>
</psalm>
