<?php

declare(strict_types=1);

use Conformance\Metadata\LanguageServerMetadata;

/**
 * The reference table of PHP language servers.
 *
 * Most cells carry a hover note explaining what the short value does and does
 * not claim, and an empty value means the project does not state it — so this
 * is where "nothing recorded" becomes the words "Not stated" or a dash. See
 * Conformance\Metadata\LanguageServerMetadata for what a record may claim.
 *
 * @var list<LanguageServerMetadata> $servers
 */

$headers = ['Language server', 'Diagnostics', 'Analyzers driven', 'Bundled with it', 'Language', 'Founder', 'Organization', 'Lead maintainer', 'License', 'Initial release', 'Latest release', 'AST / parser', 'Release announcement'];

$generalServers = array_values(array_filter(
    $servers,
    static fn (LanguageServerMetadata $server): bool => !$server->specialized() && !$server->historical(),
));
$specializedServers = array_values(array_filter(
    $servers,
    static fn (LanguageServerMetadata $server): bool => $server->specialized(),
));
$historicalServers = array_values(array_filter(
    $servers,
    static fn (LanguageServerMetadata $server): bool => $server->historical(),
));

// One row renderer shared by the three tables below.
$renderServerRow = static function (LanguageServerMetadata $server): string {
    ob_start();
    // A server that claims to drive none says so with a dash; php-lsp's own
    // engine is marked so its record in the analyzer table is not read as a
    // third-party integration.
    $analyzers = $server->analyzersDriven() === []
        ? '—'
        : implode(', ', $server->analyzersDriven()) . ($server->analyzersAreInHouse() ? ' (in-house)' : '');
    // An unstated fact is said outright rather than left blank, so a reader can
    // tell it apart from one nobody has looked up yet.
    $languages = $server->languages() === [] ? 'Not stated' : implode(', ', $server->languages());
    $parser = $server->parser() ?? 'Not stated';
    $organization = $server->organization();
    $lead = $server->lead();
    $release = $server->latestRelease;
    $announcement = $server->announcement();
?>
<tr><th class="tool-name"><a href="<?= h($server->url()) ?>" target="_blank" rel="noopener"><?= h($server->name()) ?></a></th><td><?= h_noted($server->diagnostics()->label(), $server->diagnosticsNote() ?? '') ?></td><td><?= h_noted($analyzers, $server->analyzersDrivenNote() ?? '') ?></td><td><?= h_noted($server->bundled(), $server->bundledNote() ?? '') ?></td><td><?= h_noted($languages, $server->languagesNote() ?? '') ?></td><td><?php
    $names = [];
    foreach ($server->founders() as $founder) {
        $names[] = $founder->profileUrl === null
            ? h($founder->name)
            : sprintf('<a href="%s" target="_blank" rel="noopener">%s</a>', h($founder->profileUrl), h($founder->name));
    }
    echo implode(' &amp; ', $names);
    echo $server->founderEmployer() === null ? '' : ' (' . h($server->founderEmployer()) . ')';
?></td><td><?php
    if ($organization->url === null):
        echo h($organization->label());
    else:
        ?><a href="<?= h($organization->url) ?>" target="_blank" rel="noopener"><?= h($organization->label()) ?></a><?php
    endif;
?></td><td><?php
    // Same rule as the analyzer table: linked only when the lead differs from
    // the founder, since Founder already links that person and a second link
    // would point back at itself.
    if ($lead === null):
        echo '—';
    elseif ($lead->profileUrl !== null):
        ?><a href="<?= h($lead->profileUrl) ?>" target="_blank" rel="noopener"<?= $lead->note === null ? '' : ' title="' . h($lead->note) . '"' ?>><?= h($lead->name) ?></a><?php
    elseif ($lead->note !== null):
        ?><span class="succession" title="<?= h($lead->note) ?>"><?= h($lead->name) ?></span><?php
    else:
        echo h($lead->name);
    endif;
?></td><td><?= h_noted($server->license(), $server->licenseNote() ?? '') ?></td><td><?php
    // The year cell already carries markup, so it takes the note as a wrapper
    // rather than through h_noted(), which escapes its input. Psalm needs one:
    // its server shipped in a release two months before the release that
    // announced it.
    if ($server->initialReleaseNote() === null):
        echo h_year((string) $server->initialReleaseYear());
    else:
        ?><span class="noted" title="<?= h($server->initialReleaseNote()) ?>"><?= h_year((string) $server->initialReleaseYear()) ?></span><?php
    endif;
?></td><td><?= h_release($release->version, $release->date) ?></td><td><?= h_noted($parser, $server->parserNote() ?? '') ?></td><td><?php
    if ($announcement === null):
        ?><span class="none">—</span><?php
    else:
        ?><a href="<?= h($announcement->url) ?>" target="_blank" rel="noopener"><?= h($announcement->label) ?></a><?php
    endif;
?></td></tr>
<?php
    return (string) ob_get_clean();
};
?>
<h2 class="section" id="language-servers">Language servers</h2>
<p class="section-note"><strong>Every cell in this table records what the project claims about itself</strong> &mdash; from its README, docs, changelog, release notes, package metadata, or its maintainer&rsquo;s own blog &mdash; and no claim here has been verified by executing the tool. What <em>has</em> been measured lives elsewhere: Intelephense&rsquo;s and Psalm&rsquo;s diagnostics scores are in the matrix above, and the servers this machine can launch headless have their protocol behaviour recorded in the <a href="#language-server-capabilities">measured capability matrix below</a>. Cells read <em>Not stated</em> where the project simply does not say.</p>
<p class="section-note">Four rows also appear in the analyzer table above. <strong>Intelephense</strong> and <strong>Psalm</strong> are in both as the same tool &mdash; Psalm&rsquo;s server runs the analyzer its CLI does, reached over the protocol instead of the command line. The other two are pairs: <strong>php-lsp</strong> drives <em>mir</em>, and <em>phpy</em> is the CLI frontend of <strong>devsense-php-ls</strong>. Each pair is versioned separately, so each artifact keeps its own row and its own dates. <a href="https://github.com/phan/phan" target="_blank" rel="noopener">Phan</a> ships a language server too and belongs here; it has simply not been researched yet.</p>
<div class="table-scroll"><table class="analyzer-meta">
<thead><tr>
<?php foreach ($headers as $header): ?>
<th scope="col"><?= h($header) ?></th>
<?php endforeach; ?>
</tr></thead><tbody>
<?php foreach ($generalServers as $server): ?>
<?php echo $renderServerRow($server); ?>
<?php endforeach; ?>
</tbody></table></div>
<?php if ($specializedServers !== []): ?>
<h2 class="section" id="function-specific-servers">Function-specific PHP language servers</h2>
<p class="section-note">These servers serve one framework or feature &mdash; PHPUnit test cases, a formatter, a debugger &mdash; rather than PHP as a language, so they have nothing to answer the suite&rsquo;s typing probes with. They are listed for reference only and are never launched or measured; the claims in the cells above are the projects&rsquo; own, on the same terms as the general table.</p>
<div class="table-scroll"><table class="analyzer-meta">
<thead><tr>
<?php foreach ($headers as $header): ?>
<th scope="col"><?= h($header) ?></th>
<?php endforeach; ?>
</tr></thead><tbody>
<?php foreach ($specializedServers as $server): ?>
<?php echo $renderServerRow($server); ?>
<?php endforeach; ?>
</tbody></table></div>
<?php endif; ?>
<?php if ($historicalServers !== []): ?>
<h2 class="section" id="historical-servers">Historical PHP language servers</h2>
<p class="section-note">Dead or superseded implementations, kept as a record of what came before &mdash; the parser each adopted and the PHP syntax line it reached. Like the function-specific table, they are listed for reference only and are never launched or measured; the latest release cell names the project&rsquo;s final release.</p>
<div class="table-scroll"><table class="analyzer-meta">
<thead><tr>
<?php foreach ($headers as $header): ?>
<th scope="col"><?= h($header) ?></th>
<?php endforeach; ?>
</tr></thead><tbody>
<?php foreach ($historicalServers as $server): ?>
<?php echo $renderServerRow($server); ?>
<?php endforeach; ?>
</tbody></table></div>
<?php endif; ?>
