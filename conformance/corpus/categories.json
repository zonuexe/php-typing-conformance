{
  "_comment": "Normalized diagnostic taxonomy for the corpus divergence sweep. Each tool code maps to a category; a category's `soundness` flag decides whether a cross-tool divergence there signals a real type-model disagreement (true) or is default-rule/parser/style noise (false). Unmapped codes fall to `unmapped` and are surfaced in the sweep report so this map can grow.",
  "categories": {
    "argument-type":   { "soundness": true,  "desc": "Argument type incompatible with parameter" },
    "return-type":     { "soundness": true,  "desc": "Return value incompatible with declared return" },
    "assignment-type": { "soundness": true,  "desc": "Invalid assignment / property write / mixed assignment" },
    "narrowing":       { "soundness": true,  "desc": "Type reconciliation: impossible/redundant condition, contradiction" },
    "undefined-index": { "soundness": true,  "desc": "Possibly/definitely undefined array key or destructure index" },
    "undefined-symbol":{ "soundness": true,  "desc": "Undefined class/const/method/function/property" },
    "arity":           { "soundness": true,  "desc": "Too many / too few arguments" },
    "nullsafety":      { "soundness": true,  "desc": "Null passed where non-null required" },
    "uninitialized":   { "soundness": true,  "desc": "Uninitialized property / missing constructor" },
    "operand":         { "soundness": true,  "desc": "Invalid operand in expression" },
    "throws":          { "soundness": false, "desc": "Unhandled thrown type (tool-specific default policy)" },
    "template":        { "soundness": false, "desc": "Generics/template specifics (unused param, missing type)" },
    "unused":          { "soundness": false, "desc": "Unused variable/parameter/statement/result" },
    "style":           { "soundness": false, "desc": "Style/strictness: useless cast, missing override, more-specific type" },
    "deprecation":     { "soundness": false, "desc": "Deprecated usage" },
    "parse-error":     { "soundness": false, "desc": "Annotation/type the tool cannot parse (capability gap)" },
    "tool-heuristic":  { "soundness": false, "desc": "Tool-specific false-positive-prone heuristic" },
    "unmapped":        { "soundness": false, "desc": "Not yet classified — surfaced in report for triage" }
  },
  "map": {
    "phpstan": {
      "argument.type": "argument-type",
      "argument.templateType": "argument-type",
      "return.type": "return-type",
      "return.missing": "return-type",
      "assign.propertyType": "assignment-type",
      "property.uninitialized": "uninitialized",
      "function.impossibleType": "narrowing",
      "booleanNot.alwaysFalse": "narrowing",
      "booleanAnd.alwaysFalse": "narrowing",
      "if.alwaysTrue": "narrowing",
      "offsetAccess.notFound": "undefined-index",
      "arguments.count": "arity",
      "argument.unresolvableType": "argument-type",
      "cast.useless": "style",
      "function.resultUnused": "unused",
      "expr.resultUnused": "unused",
      "missingType.generics": "template",
      "missingType.iterableValue": "template",
      "phpDoc.parseError": "parse-error",
      "class.notFound": "undefined-symbol",
      "constant.notFound": "undefined-symbol",
      "method.notFound": "undefined-symbol",
      "deprecated.function": "deprecation"
    },
    "psalm": {
      "ArgumentTypeCoercion": "argument-type",
      "InvalidArgument": "argument-type",
      "PossiblyInvalidArgument": "argument-type",
      "InvalidScalarArgument": "argument-type",
      "InvalidReturnType": "return-type",
      "InvalidReturnStatement": "return-type",
      "LessSpecificReturnStatement": "return-type",
      "MoreSpecificReturnType": "style",
      "MixedReturnStatement": "return-type",
      "MixedAssignment": "assignment-type",
      "InvalidPropertyAssignmentValue": "assignment-type",
      "TypeDoesNotContainType": "narrowing",
      "RedundantCondition": "narrowing",
      "RedundantConditionGivenDocblockType": "narrowing",
      "DocblockTypeContradiction": "narrowing",
      "PossiblyUndefinedArrayOffset": "undefined-index",
      "PossiblyUndefinedIntArrayOffset": "undefined-index",
      "PossiblyUndefinedStringArrayOffset": "undefined-index",
      "TooManyArguments": "arity",
      "TooFewArguments": "arity",
      "NullArgument": "nullsafety",
      "PossiblyNullArgument": "nullsafety",
      "UninitializedProperty": "uninitialized",
      "MissingConstructor": "uninitialized",
      "InvalidOperand": "operand",
      "UndefinedConstant": "undefined-symbol",
      "UndefinedMethod": "undefined-symbol",
      "UndefinedFunction": "undefined-symbol",
      "UnusedVariable": "unused",
      "UnusedParam": "unused",
      "MissingOverrideAttribute": "style",
      "InvalidDocblock": "parse-error",
      "UnrecognizedType": "parse-error"
    },
    "mago": {
      "invalid-argument": "argument-type",
      "possibly-invalid-argument": "argument-type",
      "incompatible-parameter-type": "argument-type",
      "false-argument": "argument-type",
      "null-argument": "nullsafety",
      "invalid-return-statement": "return-type",
      "invalid-property-write": "assignment-type",
      "invalid-property-assignment-value": "assignment-type",
      "write-only-property": "assignment-type",
      "mixed-assignment": "assignment-type",
      "impossible-assignment": "narrowing",
      "impossible-condition": "narrowing",
      "redundant-condition": "narrowing",
      "redundant-comparison": "narrowing",
      "redundant-type-comparison": "narrowing",
      "possibly-undefined-int-array-index": "undefined-index",
      "possibly-undefined-string-array-index": "undefined-index",
      "undefined-int-array-index": "undefined-index",
      "mismatched-array-index": "undefined-index",
      "list-destructure-negative-key": "undefined-index",
      "list-destructure-string-key": "undefined-index",
      "too-many-arguments": "arity",
      "too-few-arguments": "arity",
      "missing-constructor": "uninitialized",
      "uninitialized-property": "uninitialized",
      "non-existent-class-constant": "undefined-symbol",
      "invalid-operand": "operand",
      "invalid-parameter-default-value": "argument-type",
      "unhandled-thrown-type": "throws",
      "unused-template-parameter": "template",
      "unused-statement": "unused",
      "redundant-type": "style"
    },
    "phan": {
      "PhanTypeMismatchArgument": "argument-type",
      "PhanTypeMismatchArgumentInternal": "argument-type",
      "PhanTypeMismatchArgumentReal": "argument-type",
      "PhanPossiblyInfiniteRecursionSameParams": "tool-heuristic",
      "PhanTypeMismatchReturn": "return-type",
      "PhanTypeMismatchDeclaredReturn": "return-type",
      "PhanTypeMismatchDeclaredReturnNullable": "return-type",
      "PhanTypeArraySuspicious": "narrowing",
      "PhanUndeclaredConstant": "undefined-symbol",
      "PhanUndeclaredMethod": "undefined-symbol",
      "PhanUndeclaredClassConstant": "undefined-symbol",
      "PhanParamTooMany": "arity",
      "PhanParamTooFew": "arity",
      "PhanUnextractableAnnotationSuffix": "parse-error",
      "PhanUnextractableAnnotation": "parse-error",
      "PhanInvalidFQSENInCallable": "parse-error",
      "PhanInfiniteRecursion": "tool-heuristic",
      "PhanTemplateTypeNotUsedInFunctionReturn": "template",
      "PhanGenericConstructorTypes": "template",
      "PhanUnreferencedUseNormal": "unused",
      "PhanUnusedVariable": "unused"
    },
    "noverify": {
      "funcParamTypeMissMatch": "parse-error",
      "undefinedFunction": "undefined-symbol",
      "undefinedMethod": "undefined-symbol",
      "unused": "unused"
    }
  }
}
